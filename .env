# Access token: qisqa umrli (har bir so'rovda ishlatiladi)
JWT_ACCESS_SECRET=super_secret_change_in_production_please
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token: uzoq umrli (faqat yangi access token olish uchun)
JWT_REFRESH_SECRET=another_long_secret_change_in_production_too
JWT_REFRESH_EXPIRES_IN=7d
